rules_version = '2';

// Per-user data lives under users/{uid}/** and is readable/writable only by that user.
// Writes are shape-checked so a compromised or modified client can't park arbitrary or huge
// payloads in the database. Everything not matched below is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/settings/{docId} {
      allow read, delete: if isOwner(uid);

      // "budget": { <bucket>: number >= 0, ..., updatedAt: int }
      allow write: if isOwner(uid)
        && docId == 'budget'
        && request.resource.data.size() <= 20
        && request.resource.data.keys().hasOnly(
             ['Thing', 'Gifts', 'Travel', 'Church', 'Bills', 'Food', 'Other', 'updatedAt'])
        && request.resource.data.updatedAt is int;

      // "categories" / "paymentModes": { items: [string, ...], updatedAt: int }
      allow write: if isOwner(uid)
        && docId in ['categories', 'paymentModes']
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 100
        && request.resource.data.updatedAt is int;
    }
  }
}
