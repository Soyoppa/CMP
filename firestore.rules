rules_version = '2';

// All app data lives under users/{uid}/** and only that signed-in user can touch it.
// Writes are shape-checked so a modified client can't park arbitrary or huge payloads.
// Anything not matched below is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isShortString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    // --- Ledger: one document per transaction -----------------------------------------
    match /users/{uid}/transactions/{transactionId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['date', 'description', 'inflow', 'outflow', 'category', 'modeOfPayment', 'isPaid', 'createdAt'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isShortString(request.resource.data.description, 200)
        && request.resource.data.description.size() > 0
        && request.resource.data.inflow is number && request.resource.data.inflow >= 0
        && request.resource.data.outflow is number && request.resource.data.outflow >= 0
        && isShortString(request.resource.data.category, 200)
        && isShortString(request.resource.data.modeOfPayment, 200)
        && request.resource.data.isPaid is bool
        && request.resource.data.createdAt is int;
    }

    // --- Settings: budgets and editable option lists -----------------------------------
    match /users/{uid}/settings/{docId} {
      allow read, delete: if isOwner(uid);

      // "budget": { totalMonthly: number, <bucket name>: number, ..., updatedAt: int }
      allow write: if isOwner(uid)
        && docId == 'budget'
        && request.resource.data.size() <= 30
        && request.resource.data.updatedAt is int
        && (!('totalMonthly' in request.resource.data)
            || (request.resource.data.totalMonthly is number && request.resource.data.totalMonthly >= 0));

      // "categories" / "paymentModes": { items: [string, ...], updatedAt: int }
      allow write: if isOwner(uid)
        && docId in ['categories', 'paymentModes']
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 100
        && request.resource.data.updatedAt is int;
    }

    // --- Ledger access grant (Google Sheets on web) ------------------------------------
    // Created by the project owner in the Firebase console: { source: "sheets" }.
    // Clients may read (and delete, on account deletion) their own grant but never write one.
    match /users/{uid}/access/{docId} {
      allow read, delete: if isOwner(uid);
      allow write: if false;
    }
  }
}
