rules_version = '2';

// All app data lives under users/{uid}/** and only that signed-in user can touch it.
// Writes are shape-checked so a modified client can't park arbitrary or huge payloads.
// Anything not matched below is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isShortString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    // --- Ledger: one document per transaction -----------------------------------------
    match /users/{uid}/transactions/{transactionId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['date', 'description', 'inflow', 'outflow', 'category', 'modeOfPayment', 'isPaid', 'createdAt'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isShortString(request.resource.data.description, 200)
        && request.resource.data.description.size() > 0
        && request.resource.data.inflow is number && request.resource.data.inflow >= 0
        && request.resource.data.outflow is number && request.resource.data.outflow >= 0
        && isShortString(request.resource.data.category, 200)
        && isShortString(request.resource.data.modeOfPayment, 200)
        && request.resource.data.isPaid is bool
        && request.resource.data.createdAt is int;
    }

    // --- Budgets: one document per budgeting period -----------------------------------
    // Id "YYYY-MM-1" (1st–15th), "YYYY-MM-2" (16th–end of month) or "YYYY-MM" (whole month,
    // for users who budget monthly):
    // { total: number, categories: { <category name>: number, ... }, updatedAt: int }
    match /users/{uid}/budgets/{periodId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && periodId.matches('^[0-9]{4}-(0[1-9]|1[0-2])(-[12])?$')
        && request.resource.data.keys().hasOnly(['total', 'categories', 'updatedAt'])
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.categories is map
        && request.resource.data.categories.size() <= 100
        && request.resource.data.updatedAt is int;
    }

    // --- Settings: the user's own option lists, and the developer switch --------------
    match /users/{uid}/settings/{docId} {
      allow read, delete: if isOwner(uid);

      // "categories" / "incomeCategories" / "paymentModes": { items: [string, ...], updatedAt: int }
      allow write: if isOwner(uid)
        && docId in ['categories', 'incomeCategories', 'paymentModes']
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 100
        && request.resource.data.updatedAt is int;

      // "preferences": { budgetCycle: string, updatedAt: int } — how often the user budgets.
      allow write: if isOwner(uid)
        && docId == 'preferences'
        && request.resource.data.keys().hasOnly(['budgetCycle', 'updatedAt'])
        && isShortString(request.resource.data.budgetCycle, 20)
        && request.resource.data.updatedAt is int;

      // "developer": { useSheets: bool, updatedAt: int } — only matters with a Sheets grant below.
      allow write: if isOwner(uid)
        && docId == 'developer'
        && request.resource.data.keys().hasOnly(['useSheets', 'updatedAt'])
        && request.resource.data.useSheets is bool
        && request.resource.data.updatedAt is int;
    }

    // --- Household-sheet grant (developer only) -----------------------------------------
    // Created by the project owner in the Firebase console: { source: "sheets" }.
    // Clients may read (and delete, on account deletion) their own grant but never write one.
    match /users/{uid}/access/{docId} {
      allow read, delete: if isOwner(uid);
      allow write: if false;
    }
  }
}
